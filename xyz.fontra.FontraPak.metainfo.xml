<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>xyz.fontra.FontraPak</id>
  <name>FontraPak</name>
  <summary>Standalone desktop build of the Fontra font editor</summary>
  <developer id="fontra.xyz">
    <name>Fontra Project</name>
    <url>https://fontra.xyz</url>
  </developer>
  <description>
    <p>
      FontraPak is a cross-platform desktop application bundling the open-source, browser-based Fontra font editor. Fontra is developed by Black[Foundry] and Just van Rossum with support from Google Fonts.
    </p>
    <p>
      Fontra focuses on variable font technology and advanced workflows for large font projects such as CJK, offering deeper variable font integration than traditional editors. As a standalone package, FontraPak allows easy installation and use outside the browser, bringing the full editing environment to your desktop.
    </p>
  </description>
  <url type="homepage">https://fontra.xyz/</url>
  <url type="bugtracker">https://github.com/fontra/fontra-pak/issues</url>
  <url type="help">https://docs.fontra.xyz/</url>
  <url type="vcs-browser">https://github.com/fontra/fontra-flatpak</url>
  <categories>
    <category>Graphics</category>
    <category>Development</category> 
  </categories>
  <launchable type="desktop-id">xyz.fontra.FontraPak.desktop</launchable>
  <releases>
    <release version="2026.8.0" date="2026-08-29">
      <description>
        <p>New features</p>
        <ul>
          <li>Added a new font info panel to author and edit conditional substitutions (Designspace Rules).</li>
          <li>[fontra-glyphs] Support reading of Glyphs-specific feature variation syntax.</li>
          <li>Allow the font size in the OpenType code editor to be changed with Zoom In and Zoom Out menu items in the View menu.</li>
          <li>Optionally show handles and nodes in background layers. Toggle via View -&gt; Glyph editor appearance.</li>
          <li>[languages] Initial Russian translation.</li>
          <li>[languages] Initial Italian translation.</li>
          <li>[languages] Separate Spanish for Spain and Latin America.</li>
        </ul>
        <p>Fixes</p>
        <ul>
          <li>Fix editing the left sidebearing in the Selection Info panel to move anchors and guidelines.</li>
          <li>Support glyph names with spaces.</li>
          <li>Fix the menu item background color in dark mode when the item has a submenu.</li>
          <li>Fix behavior when a character is not encoded, but the suggested glyph name exists in the font.</li>
        </ul>
        <p>Improvements</p>
        <ul>
          <li>Spanish, Portuguese, Chinese, and French localization improvements.</li>
        </ul>
      </description>
    </release>
